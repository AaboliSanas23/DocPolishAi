# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# env & secrets (never commit real keys)
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
id_rsa*
id_ed25519*
