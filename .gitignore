# misc
.DS_Store
Thumbs.db

# MS Word — sample uploads / working copies (keep local only)
*.doc
*.docx
*.docm

# MS Word lock files while a document is open
~$*.docx

npm-debug.log*
yarn-debug.log*
yarn-error.log*
